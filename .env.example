# Darukaa.Earth AI Environmental Scientist — Environment Configuration

# Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://darukaa-earth-ai.vercel.app"]

# Rate Limiting & Abuse Controls
RATE_LIMIT_ANONYMOUS_PER_MINUTE=5
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=20
MAX_QUERY_CHAR_LENGTH=1000
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_PAGES=100
MAX_DOCUMENTS_PER_USER=10

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=darukaa_knowledge
QDRANT_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_SPARSE_MODEL=Qdrant/bm25
DENSE_VECTOR_SIZE=384

# LLM Providers (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
LLM_PRIMARY_MODEL=gemini-3.1-flash-lite
LLM_SECONDARY_MODEL=gemini-3.5-flash
# Optional Fallback (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Auth, Postgres & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy verification fallback (if not using asymmetric JWKS)
SUPABASE_JWT_SECRET=
